+static RtResultVoid unload_module_impl(const char* name_no_ext, bool check_references)
+{
+    if (name_no_ext == nullptr)
+    {
+        RET_ERR(RtErr::ArgumentNull);
+    }
+    metadata::RtModuleDef* mod = metadata::RtModuleDef::find_module(name_no_ext);
+    if (mod == nullptr)
+    {
+        RET_ERR(RtErr::FileNotFound);
+    }
+    if (mod->is_corlib())
+    {
+        RET_ERR(RtErr::InvalidOperation);
+    }
+
+    // Cross-module references block single-module unload; the caller decides the fallback policy.
+    // Group unload skips this check because all members (including cyclic referrers) are removed.
+    if (check_references)
+    {
+        utils::Vector<metadata::RtModuleDef*> modules;
+        metadata::RtModuleDef::get_registered_modules(modules);
+        for (metadata::RtModuleDef* other : modules)
+        {
+            if (other != nullptr && other != mod && other->references_assembly(name_no_ext))
+            {
+                RET_ERR(RtErr::InvalidOperation);
+            }
+        }
+    }
+
+    // First GC pass: clear objects reachable only from managed object fields.
+    gc::GarbageCollector::collect();
+
+    // Release static roots of the module, then drop all lazily rebuildable caches.
+    Class::remove_static_data_for_module(mod);
+    Class::clear_caches_for_module_unload();
+    ArrayClass::remove_module_classes(mod);
+    Reflection::shutdown();
+    GenericMethod::shutdown();
+    metadata::MetadataCache::reset();
+
+    // Second GC pass: objects held only by static fields are now unreachable; klass is still valid.
+    gc::GarbageCollector::collect();
+
+    metadata::RtAssembly* ass = mod->get_assembly();
+    alloc::MemPool* pool = &mod->get_mem_pool();
+    metadata::PdbImage* pdb = mod->get_pdb_image();
+    const uint8_t* image_data = mod->get_cli_image().get_image_data();
+    const uint8_t* pdb_data = pdb != nullptr ? pdb->get_raw_image_data() : nullptr;
+
+    metadata::RtModuleDef::unregister_module_def(mod);
+    alloc::GeneralAllocation::delete_any(mod);
+    if (pdb != nullptr)
+    {
+        alloc::GeneralAllocation::delete_any(pdb);
+    }
+    if (ass != nullptr)
+    {
+        alloc::GeneralAllocation::free(ass);
+    }
+    if (image_data != nullptr)
+    {
+        alloc::GeneralAllocation::free(const_cast<uint8_t*>(image_data));
+    }
+    if (pdb_data != nullptr)
+    {
+        alloc::GeneralAllocation::free(const_cast<uint8_t*>(pdb_data));
+    }
+    alloc::GeneralAllocation::delete_any(pool);
+
+    RET_VOID_OK();
+}
+
+RtResultVoid Assembly::unload_module(const char* name_no_ext)
+{
+    return unload_module_impl(name_no_ext, true);
+}
+
+RtResultVoid Assembly::unload_module_unchecked(const char* name_no_ext)
+{
+    return unload_module_impl(name_no_ext, false);
+}
