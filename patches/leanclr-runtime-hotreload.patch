+bool RtModuleDef::references_assembly(const char* name_no_ext) const
+{
+    if (name_no_ext == nullptr)
+    {
+        return false;
+    }
+    for (uint32_t i = 1; i <= _referenceAssemblyCount; ++i)
+    {
+        const ReferenceAssembly& ref_asm = _referenceAssemblies[i - 1];
+        if (ref_asm.status == AssemblyResolveStatus::Success && ref_asm.assembly != nullptr)
+        {
+            const RtModuleDef* ref_mod = ref_asm.assembly->mod;
+            if (ref_mod != nullptr && strcmp(ref_mod->get_name_no_ext(), name_no_ext) == 0)
+            {
+                return true;
+            }
+            continue;
+        }
+        auto row = _cliImage.read_assembly_ref(i);
+        if (!row)
+        {
+            continue;
+        }
+        auto name_ret = get_string(row.value().name);
+        if (name_ret.is_err())
+        {
+            continue;
+        }
+        if (strcmp(name_ret.unwrap(), name_no_ext) == 0)
+        {
+            return true;
+        }
+    }
+    return false;
+}
