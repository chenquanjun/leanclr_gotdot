+void Class::remove_static_data_for_module(const metadata::RtModuleDef* module_def)
+{
+    if (module_def == nullptr)
+    {
+        return;
+    }
+    for (size_t i = 0; i < s_all_classes_with_static_data.size();)
+    {
+        const metadata::RtClass* klass = s_all_classes_with_static_data[i];
+        if (klass != nullptr && klass->image == module_def)
+        {
+            if (klass->static_fields_data != nullptr)
+            {
+                alloc::GeneralAllocation::free(klass->static_fields_data);
+            }
+            s_all_classes_with_static_data[i] = s_all_classes_with_static_data.back();
+            s_all_classes_with_static_data.pop_back();
+            continue;
+        }
+        ++i;
+    }
+}
