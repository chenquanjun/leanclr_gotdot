<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DemoVariant Condition="'$(DemoVariant)' == ''">v1</DemoVariant>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>LeanClrGameDemo</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>../godot_project/game_demo_tmp/build/$(DemoVariant)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DefineConstants Condition="'$(DemoVariant)' == 'v2'">DEMO_V2</DefineConstants>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)demo_$(DemoVariant)/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="GameDemoTuning.cs" />
    <Compile Include="GameDemo.cs" />
  </ItemGroup>
</Project>
